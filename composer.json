{
  "name": "digitalastronaut/craft-core-seo-geo",
  "description": "A no fluff SEO/GEO solution for Craft CMS websites",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "bram@digitalastronaut.be",
    "issues": "https://github.com/digitalastronaut-be/craft-core-seo-geo/issues?state=open",
    "source": "https://github.com/digitalastronaut-be/craft-core-seo-geo",
    "docs": "https://github.com/digitalastronaut-be/craft-core-seo-geo",
    "rss": "https://github.com/digitalastronaut-be/craft-core-seo-geo/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.11.0",
    "nystudio107/craft-code-editor": "^1.0.30",
    "nystudio107/craft-plugin-vite": "^5.0.0",
    "spatie/schema-org": "^4.0.2",
    "starfederation/datastar-php": "^1.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "digitalastronaut\\craftcoreseogeo\\": "src/"
    }
  },
  "extra": {
    "handle": "core-seo-geo",
    "name": "Core SEO/GEO",
    "developer": "Digitalastronaut",
    "documentationUrl": "https://github.com/digitalastronaut-be/craft-core-seo-geo",
    "class": "digitalastronaut\\craftcoreseogeo\\CoreSeoGeo"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
