{# @var field \digitalastronaut\craftcoreseogeo\fields\SeoField #}
{# @var value \digitalastronaut\craftcoreseogeo\models\SeoData #}
{# @var element \craft\base\ElementInterface|null #}
{# @var id string #}
{# @var name string #}
{# @var image \craft\elements\Asset|null #}
{# @var fallbackImage \craft\elements\Asset|null the section/global image this field would fall back to if left empty #}
{# @var fallbackRobots string[] the section/global robots directives this field would fall back to if left empty #}
{# @var sitemapWarning string|null set when the "Exclude from sitemap" switch below currently has no effect either way, because the site or this section already has sitemap generation disabled #}
{# @var fallbackSource string|null 'content' or 'global', where fallbackImage came from #}
{# @var titleFormatRows array<int, array{rowId: string, label: string, template: string, editable: bool}> #}
{# @var descriptionFormatRows array<int, array{rowId: string, label: string, template: string, editable: bool}> #}
{# @var titleRowValues array<int, string|null> posted/stored override text per titleFormatRows row, same keys #}
{# @var descriptionRowValues array<int, string|null> posted/stored override text per descriptionFormatRows row, same keys #}

{% import '_includes/forms.twig' as forms %}

{% set enabledFields = field.enabledInputFields %}
{% set showImage = 'image' in enabledFields %}
{% set showTitle = 'title' in enabledFields and titleFormatRows is not empty %}
{% set showDescription = 'description' in enabledFields and descriptionFormatRows is not empty %}
{% set showCanonicalUrl = 'canonicalUrl' in enabledFields %}
{% set showRobots = 'robots' in enabledFields %}
{% set showExcludeFromSitemap = 'excludeFromSitemap' in enabledFields %}
{% set showPreviews = 'previews' in enabledFields %}
{% set showTextColumn = showTitle or showDescription or showCanonicalUrl or showRobots or showExcludeFromSitemap %}

<div class="pane hairline" style="overflow: hidden;">
    <div class="flex-fields core-seo-geo-flex-fields">
        {% if showImage %}
            <div class="{{ showTextColumn ? 'width-25' : 'width-100' }}">
                {{ forms.elementSelectField({
                    id: "#{id}-image",
                    name: "#{name}[image]",
                    label: 'Image'|t('core-seo-geo'),
                    elementType: 'craft\\elements\\Asset',
                    elements: image ? [image] : [],
                    criteria: {kind: 'image'},
                    single: true,
                    viewMode: 'thumbs',
                    selectionLabel: 'Choose an image'|t('core-seo-geo'),
                    fieldAttributes: {style: 'margin-bottom: 12px;'},
                    tip: (not image and fallbackImage) ? (fallbackSource == 'content'
                        ? 'Inherited from content'|t('core-seo-geo')
                        : 'Inherited from global'|t('core-seo-geo')) : null,
                }) }}

                {% if not image and fallbackImage %}
                    <div style="margin-top: var(--s); opacity: 0.6;">
                        {{ elementChip(fallbackImage, {size: 'large', showLabel: true, showStatus: false, autoReload: false}) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if showTextColumn %}
        <div class="field {{ showImage ? 'width-75' : 'width-100' }}">
            {% if showTitle %}
                <div class="field">
                    <div class="heading">
                        <label>{{ 'Title'|t('core-seo-geo') }}</label>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: var(--s);">
                        {% for i, row in titleFormatRows %}
                            {% set editable = row.editable ?? false %}
                            {% set resolved = element ? renderObjectTemplate(row.template, element) : row.template %}
                            {% set rowValue = (editable ? (titleRowValues[i] ?? resolved) : resolved)|default('') %}

                            <div style="flex: 0 1 auto; min-width: 0; max-width: 100%;">
                                {{ forms.textareaField({
                                    id: "#{id}-titleRows-#{i}",
                                    name: "#{name}[titleRows][#{row.rowId}]",
                                    value: rowValue,
                                    disabled: not editable,
                                    placeholder: row.label ?? null,
                                    rows: 1,
                                    inputAttributes: {style: {width: 'auto', 'max-width': '100%', 'box-sizing': 'border-box', 'field-sizing': 'content', resize: 'none'}},
                                }) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if showDescription %}
                <div class="field">
                    <div class="heading">
                        <label>{{ 'Description'|t('core-seo-geo') }}</label>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: var(--s);">
                        {% for i, row in descriptionFormatRows %}
                            {% set editable = row.editable ?? false %}
                            {% set resolved = element ? renderObjectTemplate(row.template, element) : row.template %}
                            {% set rowValue = (editable ? (descriptionRowValues[i] ?? resolved) : resolved)|default('') %}

                            <div style="flex: 0 1 auto; min-width: 0; max-width: 100%;">
                                {{ forms.textareaField({
                                    id: "#{id}-descriptionRows-#{i}",
                                    name: "#{name}[descriptionRows][#{row.rowId}]",
                                    value: rowValue,
                                    disabled: not editable,
                                    placeholder: row.label ?? null,
                                    rows: 1,
                                    inputAttributes: {style: {width: 'auto', 'max-width': '100%', 'box-sizing': 'border-box', 'field-sizing': 'content', resize: 'none'}},
                                }) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if showCanonicalUrl %}
                {{ forms.textField({
                    id: "#{id}-canonicalUrl",
                    name: "#{name}[canonicalUrl]",
                    label: 'Canonical URL'|t('core-seo-geo'),
                    value: value.canonicalUrl,
                    placeholder: element and element.url ? element.url : null,
                    type: 'url',
                }) }}
            {% endif %}

            {% if showRobots %}
                {% set fallbackRobotsLabel = field.getRobotsOptions()
                    |filter(o => o.value is defined and o.value in fallbackRobots)
                    |map(o => o.label)
                    |join(', ') %}

                {{ forms.selectizeField({
                    id: "#{id}-robots",
                    name: "#{name}[robots]",
                    multi: true,
                    label: 'Robots/AI Visibility'|t('core-seo-geo'),
                    values: value.robots,
                    options: field.getRobotsOptions(),
                    selectizeOptions: fallbackRobotsLabel ? {placeholder: fallbackRobotsLabel} : {},
                }) }}
            {% endif %}

            {% if showExcludeFromSitemap %}
                {{ forms.lightswitchField({
                    id: "#{id}-excludeFromSitemap",
                    name: "#{name}[excludeFromSitemap]",
                    label: 'Exclude from sitemap'|t('core-seo-geo'),
                    warning: sitemapWarning,
                    on: value.excludeFromSitemap,
                    onLabel: 'Excluded'|t('core-seo-geo'),
                    offLabel: 'Included'|t('core-seo-geo'),
                }) }}
            {% endif %}
        </div>
        {% endif %}

        {% if showPreviews %}
            {% include "core-seo-geo/fields/seo/_previews.twig" with {
                solo: not showImage and not showTextColumn,
            } %}
        {% endif %}
    </div>
</div>
