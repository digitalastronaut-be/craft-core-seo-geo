{# @var id string #}
{# @var name string #}
{# @var json string #}
{# @var rows int #}

{% import 'codeeditor/codeEditor' as codeEditor %}

{{ codeEditor.textarea({
    id: id,
    name: name,
    value: json,
    disabled: true,
    class: ['code'],
    rows: rows,
}, 'CodeEditor', {
    theme: 'vs',
    language: 'json',
    domReadOnly: true,
    readOnly: true,
    lineNumbers: 'on',
    lineNumbersMinChars: 3,
    lineDecorationsWidth: 16,
}, {
    wrapperClass: 'monaco-editor-background-frame',
}) }}
