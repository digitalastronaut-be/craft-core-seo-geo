{# @var type string #}
{# @var typeLabel string #}
{# @var typeTree array #}
{# @var expandedTypes string[] #}
{# @var properties array<string, array{template: string}> #}
{# @var propertyGroups array<string, array{label: string, properties: string[]}> #}
{# @var propertyTooltips array<string, string> #}
{# @var calculatedValueHtml array<string, string>|null #}
{# @var previewEntry \craft\elements\Entry|null #}
{# @var previewEntryCriteria array|null restricts the "Preview Entry" picker, e.g. {section: 'blog'} #}
{# @var jsonLdPreview string|null the full, pretty-printed JSON-LD rendered against `previewEntry` #}

{% import '_includes/forms.twig' as forms %}
{% import "codeeditor/codeEditor" as codeEditor %}

{% js %}
    window.coreSeoGeoDisposeEditor = function(id) {
        var instances = window.monacoEditorInstances || {};
        var editor = instances[id];
        if (!editor) return;

        editor.dispose();
        delete instances[id];
    };

    window.coreSeoGeoDisposeAllPropertyEditors = function() {
        var instances = window.monacoEditorInstances || {};
        Object.keys(instances).forEach(function(id) {
            if (id.indexOf('core-seo-geo-property-template-') === -1) return;
            window.coreSeoGeoDisposeEditor(id);
        });
    };
{% endjs %}

<div class="core-seo-geo-mapping-loading flex flex-justify-center" style="padding: var(--xl) 0;">
    <div class="spinner big"></div>
</div>

<div
    class="flex-fields core-seo-geo-structured-data-settings hidden"
    data-signals="{
        typeSearch: '',
        propertySearch: '',
        type: '{{ type|default('') }}',
        properties: {{ properties|default({})|json_encode(constant('JSON_FORCE_OBJECT')) }}
    }">

    <input type="hidden" name="type" data-bind:type>

    <div class="field">
        <div class="heading">
            <label>{{ "Settings"|t('core-seo-geo') }}</label>
        </div>
        <p class="instructions">{{ "Please configure the correct schema type and properties and then map them to the entry data as needed"|t('core-seo-geo') }}</p>

        <div class="pane hairline">
            {{ forms.elementSelectField({
                id: 'preview-element',
                name: 'previewElementId',
                label: 'Preview Entry'|t('core-seo-geo'),
                instructions: 'Choose an entry to calculate each property\'s value against, for reference. Recalculated on save, not live as you type.'|t('core-seo-geo'),
                elementType: 'craft\\elements\\Entry',
                elements: previewEntry ? [previewEntry] : [],
                criteria: previewEntryCriteria|default(null),
                single: true,
                selectionLabel: 'Choose an entry'|t('core-seo-geo'),
            }) }}
        </div>

        <div class="core-seo-geo-structured-data-selectors pane hairline">
            <div class="core-seo-geo-structured-data-selectors-top">
                {% include 'core-seo-geo/fields/structured-data/_schemaTypeSelector.twig' with {
                    typeTree: typeTree,
                    expandedTypes: expandedTypes,
                } only %}

                {% include 'core-seo-geo/fields/structured-data/_schemaPropertiesSelector.twig' with {
                    propertyGroups: propertyGroups,
                    propertyTooltips: propertyTooltips|default({}),
                } only %}
            </div>

            {% include 'core-seo-geo/fields/structured-data/_schemaSelectedPills.twig' with {
                typeName: type|default(''),
                typeLabel: typeLabel|default(''),
                names: properties|default({})|keys,
            } only %}
        </div>

        <div class="core-seo-geo-mapping-section">
            {% include 'core-seo-geo/fields/structured-data/_schemaPropertiesTable.twig' with {
                names: properties|default({})|keys,
                properties: properties|default({}),
                propertyTooltips: propertyTooltips|default({}),
                calculatedValueHtml: calculatedValueHtml ?? null,
            } only %}
        </div>

        <div class="core-seo-geo-mapping-jsonld-preview field">
            <div class="heading">
                <label>{{ "JSON-LD Preview"|t('core-seo-geo') }}</label>
            </div>

            {% if jsonLdPreview is not null %}
                {% set jsonLdRows = min(max(jsonLdPreview|split("\n")|length, 4), 20) %}
                {{ codeEditor.textarea({
                    id: 'core-seo-geo-jsonld-preview',
                    value: jsonLdPreview,
                    disabled: true,
                    class: ['code'],
                    rows: jsonLdRows,
                }, 'CodeEditor', { theme: 'vs', language: 'json', domReadOnly: true, readOnly: true, lineNumbers: 'on', lineNumbersMinChars: 3, lineDecorationsWidth: 16 }, {
                    wrapperClass: 'monaco-editor-background-frame',
                }) }}
            {% elseif previewEntry %}
                <code>{{ 'Save to see the full JSON-LD preview.'|t('core-seo-geo') }}</code>
            {% else %}
                <code>{{ 'Choose a preview entry above to see the full JSON-LD preview.'|t('core-seo-geo') }}</code>
            {% endif %}
        </div>
    </div>
</div>

{% js %}
    window.setTimeout(function() {
        var loading = document.querySelector('.core-seo-geo-mapping-loading');
        var settings = document.querySelector('.core-seo-geo-structured-data-settings');

        if (loading) loading.classList.add('hidden');
        if (settings) settings.classList.remove('hidden');
    }, 500);
{% endjs %}
