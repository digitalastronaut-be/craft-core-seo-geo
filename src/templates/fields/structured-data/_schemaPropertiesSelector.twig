{# @var propertyGroups array<string, array{label: string, properties: string[]}> #}
{# @var propertyTooltips array<string, string> #}

{% set searchPropertiesAction = actionUrl('core-seo-geo/structured-data-field/search-properties') %}

<div class="core-seo-geo-property-selector">
    <input
        type="text"
        id="core-seo-geo-property-search"
        class="clearable text fullwidth"
        autocomplete="off"
        placeholder="{{ 'Search schema properties'|t('app') }}"
        data-star-show="$type"
        data-star-bind:property-search
        data-star-on:input__debounce.300ms="@get('{{ searchPropertiesAction }}')"
    >

    {% include 'core-seo-geo/fields/structured-data/_schemaPropertiesSelectorOptions.twig' with {
        searching: false,
        propertyLabels: {},
        propertyGroups: propertyGroups,
        propertyTooltips: propertyTooltips,
    } only %}
</div>
