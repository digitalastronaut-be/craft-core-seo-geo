{# @var typeTree array #}
{# @var expandedTypes string[] #}

{% set searchTypesAction = actionUrl('core-seo-geo/structured-data-field/search-types') %}

<div class="core-seo-geo-type-selector">
    <input
        type="text"
        id="core-seo-geo-type-search"
        class="clearable text fullwidth"
        placeholder="{{ 'Search schema types'|t('app') }}"
        data-star-bind:search
        data-star-on:input__debounce.300ms="@get('{{ searchTypesAction }}')"
    >

    {% include 'core-seo-geo/fields/structured-data/_schemaTypeSelectorOptions.twig' with {
        typeTree: typeTree,
        expandedTypes: expandedTypes,
        forceOpen: false,
    } only %}
</div>
