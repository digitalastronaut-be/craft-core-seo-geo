{# @var typeTree array #}
{# @var expandedTypes string[] #}
{# @var forceOpen bool #}

<ul class="core-seo-geo-type-list core-seo-geo-type-options">
    {% if typeTree is empty %}
        <li class="core-seo-geo-no-results">{{ "No results found"|t('core-seo-geo') }}</li>
    {% else %}
        {% for node in typeTree %}
            {% include 'core-seo-geo/fields/structured-data/_schemaTypeTreeNode.twig' with {
                node: node,
                expandedTypes: expandedTypes,
                forceOpen: forceOpen|default(false),
                depth: 0,
            } only %}
        {% endfor %}
    {% endif %}
</ul>
