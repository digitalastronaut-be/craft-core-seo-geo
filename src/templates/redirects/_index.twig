{% extends '_layouts/cp.twig' %}

{% set title = 'Redirects'|t('core-seo-geo') %}
{% set selectedSubnavItem = 'redirects' %}

{% set tabs = {
    redirects: { label: 'Redirects'|t('core-seo-geo'), url: url('core-seo-geo/redirects') },
    notFoundLog: { label: '404s'|t('core-seo-geo'), url: url('core-seo-geo/redirects/not-found-log') },
} %}
{% set selectedTab = 'redirects' %}

{% block actionButton %}
    <a href="{{ url('core-seo-geo/redirects/new') }}" class="btn submit add icon">
        {{ 'Add redirect'|t('core-seo-geo') }}
    </a>
{% endblock %}

{% block content %}
    <table id="redirects-table" class="data fullwidth"{% if not redirects|length %} style="display: none;"{% endif %}>
        <thead>
            <tr>
                <th scope="col">{{ 'Source'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Destination'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Type'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Status'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Hits'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Enabled'|t('core-seo-geo') }}</th>
                <td class="thin"></td>
            </tr>
        </thead>
        <tbody>
            {% for redirect in redirects %}
                <tr data-id="{{ redirect.id }}">
                    <td>
                        <a href="{{ url('core-seo-geo/redirects/' ~ redirect.id) }}"><code>/{{ redirect.sourceUri }}</code></a>
                        {% if redirect.sourceElementId %}
                            <div class="light">{{ 'Auto-created'|t('core-seo-geo') }}</div>
                        {% endif %}
                    </td>
                    <td>{% if redirect.destinationUri %}<code>{{ redirect.destinationUri }}</code>{% else %}&ndash;{% endif %}</td>
                    <td>{{ redirect.matchType == 'regex' ? 'Regex'|t('core-seo-geo') : 'Exact'|t('core-seo-geo') }}</td>
                    <td>{{ redirect.statusCode }}</td>
                    <td>{{ redirect.hitCount }}</td>
                    <td>{{ enabledStatusHtmlById[redirect.id]|raw }}</td>
                    <td class="thin">
                        <a class="delete icon redirect-delete-btn" title="{{ 'Delete'|t('core-seo-geo') }}" aria-label="{{ 'Delete'|t('core-seo-geo') }}" role="button" data-id="{{ redirect.id }}"></a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div id="redirects-zilch" class="zilch small"{% if redirects|length %} style="display: none;"{% endif %}>{{ 'No redirects yet.'|t('core-seo-geo') }}</div>
{% endblock %}

{% js %}
    $('.redirect-delete-btn').on('click', function() {
        var $btn = $(this);

        if (!confirm({{ 'Are you sure you want to delete this redirect?'|t('core-seo-geo')|json_encode|raw }})) {
            return;
        }

        $btn.addClass('loading');

        Craft.sendActionRequest('POST', 'core-seo-geo/redirects/delete', {
            data: {
                id: $btn.data('id'),
            },
        }).then(function(response) {
            Craft.cp.displayNotice(response.data.message);
            $btn.closest('tr').remove();

            if (!$('#redirects-table tbody tr').length) {
                $('#redirects-table').hide();
                $('#redirects-zilch').show();
            }
        }).catch(function(error) {
            $btn.removeClass('loading');
            Craft.cp.displayError(error?.response?.data?.message);
        });
    });
{% endjs %}
