{% extends '_layouts/cp.twig' %}

{% set title = 'Redirects'|t('core-seo-geo') %}
{% set selectedSubnavItem = 'redirects' %}
{% set crumbs = [
    { label: craft.coreSeoGeo.rootLabel(), url: url('core-seo-geo') },
    { label: title },
] %}

{% set tabs = {
    redirects: { label: 'Redirects'|t('core-seo-geo'), url: url('core-seo-geo/redirects') },
    notFoundLog: { label: '404s'|t('core-seo-geo'), url: url('core-seo-geo/redirects/not-found-log') },
} %}
{% set selectedTab = 'redirects' %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% block actionButton %}
    <a href="{{ url('core-seo-geo/redirects/new') }}" class="btn submit add icon">
        {{ 'Add redirect'|t('core-seo-geo') }}
    </a>
{% endblock %}

{% block content %}
    {% include 'core-seo-geo/redirects/_chart.twig' %}

    <div id="redirects-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        container: '#redirects-vue-admin-table',
        tableDataEndpoint: 'core-seo-geo/redirects/table-data',
        deleteAction: 'core-seo-geo/redirects/delete',
        search: true,
        fullPane: false,
        emptyMessage: {{ 'No redirects yet.'|t('core-seo-geo')|json_encode|raw }},
        deleteSuccessMessage: {{ 'Redirect deleted.'|t('core-seo-geo')|json_encode|raw }},
        deleteFailMessage: {{ "Couldn’t delete the redirect."|t('core-seo-geo')|json_encode|raw }},
        columns: [
            { name: '__slot:title', title: {{ 'Source'|t('core-seo-geo')|json_encode|raw }}, sortField: true },
            { name: 'destination', title: {{ 'Destination'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'matchType', title: {{ 'Type'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'origin', title: {{ 'Origin'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'statusCode', title: {{ 'Status'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'hits', title: {{ 'Hits'|t('core-seo-geo')|json_encode|raw }}, sortField: true },
            { name: 'lastHit', title: {{ 'Last hit'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'enabled', title: {{ 'Enabled'|t('core-seo-geo')|json_encode|raw }} },
        ],
    });
{% endjs %}
