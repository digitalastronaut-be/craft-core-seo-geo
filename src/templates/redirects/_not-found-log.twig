{% extends '_layouts/cp.twig' %}

{% set title = '404s'|t('core-seo-geo') %}
{% set selectedSubnavItem = 'redirects' %}
{% set crumbs = [
    { label: craft.coreSeoGeo.rootLabel(), url: url('core-seo-geo') },
    { label: title },
] %}

{% set tabs = {
    redirects: { label: 'Redirects'|t('core-seo-geo'), url: url('core-seo-geo/redirects') },
    notFoundLog: { label: '404s'|t('core-seo-geo'), url: url('core-seo-geo/redirects/not-found-log') },
} %}
{% set selectedTab = 'notFoundLog' %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% block content %}
    {% include 'core-seo-geo/redirects/_chart.twig' %}

    <div id="not-found-log-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        container: '#not-found-log-vue-admin-table',
        tableDataEndpoint: 'core-seo-geo/redirects/not-found-log-table-data',
        deleteAction: 'core-seo-geo/redirects/delete-not-found-log-entry',
        search: true,
        fullPane: false,
        emptyMessage: {{ 'No unmatched 404s yet.'|t('core-seo-geo')|json_encode|raw }},
        deleteSuccessMessage: {{ 'Log entry deleted.'|t('core-seo-geo')|json_encode|raw }},
        deleteFailMessage: {{ "Couldn’t delete the log entry."|t('core-seo-geo')|json_encode|raw }},
        columns: [
            { name: '__slot:title', title: {{ 'URI'|t('core-seo-geo')|json_encode|raw }}, sortField: true },
            { name: 'type', title: {{ 'Type'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'hits', title: {{ 'Hits'|t('core-seo-geo')|json_encode|raw }}, sortField: true },
            { name: 'lastHit', title: {{ 'Last hit'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'referrer', title: {{ 'Referrer'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'handled', title: {{ 'Status'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'createRedirect', title: '' },
        ],
    });
{% endjs %}
