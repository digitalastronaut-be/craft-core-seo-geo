{% extends '_layouts/cp.twig' %}

{% set title = '404s'|t('core-seo-geo') %}
{% set selectedSubnavItem = 'redirects' %}

{% set tabs = {
    redirects: { label: 'Redirects'|t('core-seo-geo'), url: url('core-seo-geo/redirects') },
    notFoundLog: { label: '404s'|t('core-seo-geo'), url: url('core-seo-geo/redirects/not-found-log') },
} %}
{% set selectedTab = 'notFoundLog' %}

{% block content %}
    <p class="light">{{ 'Every URI that 404\'d and matched no redirect, with how often it was hit. A URI that gets a redirect stops appearing here once it\'s no longer a gap to fix.'|t('core-seo-geo') }}</p>

    <table id="not-found-log-table" class="data fullwidth"{% if not entries|length %} style="display: none;"{% endif %}>
        <thead>
            <tr>
                <th scope="col">{{ 'URI'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Hits'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Last hit'|t('core-seo-geo') }}</th>
                <th scope="col">{{ 'Referrer'|t('core-seo-geo') }}</th>
                <td class="thin"></td>
                <td class="thin"></td>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr data-id="{{ entry.id }}">
                    <td><code>/{{ entry.uri }}</code></td>
                    <td>{{ entry.hitCount }}</td>
                    <td>{{ entry.dateLastHit ? entry.dateLastHit|datetime('short') : '–' }}</td>
                    <td>{{ entry.referrer ?: '–' }}</td>
                    <td class="thin">
                        <a href="{{ url('core-seo-geo/redirects/new', { source: entry.uri }) }}" class="btn small">{{ 'Create redirect'|t('core-seo-geo') }}</a>
                    </td>
                    <td class="thin">
                        <a class="delete icon not-found-log-delete-btn" title="{{ 'Delete'|t('core-seo-geo') }}" aria-label="{{ 'Delete'|t('core-seo-geo') }}" role="button" data-id="{{ entry.id }}"></a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div id="not-found-log-zilch" class="zilch small"{% if entries|length %} style="display: none;"{% endif %}>{{ 'No unmatched 404s yet.'|t('core-seo-geo') }}</div>
{% endblock %}

{% js %}
    $('.not-found-log-delete-btn').on('click', function() {
        var $btn = $(this);

        if (!confirm({{ 'Are you sure you want to delete this log entry?'|t('core-seo-geo')|json_encode|raw }})) {
            return;
        }

        $btn.addClass('loading');

        Craft.sendActionRequest('POST', 'core-seo-geo/redirects/delete-not-found-log-entry', {
            data: {
                id: $btn.data('id'),
            },
        }).then(function(response) {
            Craft.cp.displayNotice(response.data.message);
            $btn.closest('tr').remove();

            if (!$('#not-found-log-table tbody tr').length) {
                $('#not-found-log-table').hide();
                $('#not-found-log-zilch').show();
            }
        }).catch(function(error) {
            $btn.removeClass('loading');
            Craft.cp.displayError(error?.response?.data?.message);
        });
    });
{% endjs %}
