{% requireAdmin false %}

{% extends '_layouts/cp.twig' %}

{% set title = title ?? 'SEO/GEO'|t('core-seo-geo') %}
{% set docTitle = docTitle ?? (title ~ ' - SEO/GEO') %}

{% set crumbs = [
    { label: craft.coreSeoGeo.rootLabel(), url: url('core-seo-geo') },
]|merge(extraCrumbs ?? []) %}

{% if urlFormat is defined %}
    {% set siteIds = craft.app.sites.getEditableSiteIds() %}

    {% if siteIds|length > 1 %}
        {% set groups = craft.app.sites.getAllGroups() %}
        {% set showGroupHeadings = groups|length > 1 %}
        {% set siteMenuItems = [] %}

        {% for group in groups %}
            {% set groupSiteIds = group.getSiteIds()|intersect(siteIds) %}

            {% if groupSiteIds %}
                {% set groupItems = [] %}

                {% for siteId in groupSiteIds %}
                    {% set menuSite = craft.app.sites.getSiteById(siteId) %}
                    {% set groupItems = groupItems|merge([{
                        label: menuSite.name|t('site'),
                        url: urlFormat|replace({ '{id}': siteId, '{handle}': menuSite.handle }),
                        selected: siteId == selectedSiteId,
                    }]) %}
                {% endfor %}

                {% set siteMenuItems = siteMenuItems|merge(showGroupHeadings ? [{
                    heading: group.name|t('site'),
                    items: groupItems,
                }] : groupItems) %}
            {% endif %}
        {% endfor %}

        {% set crumbs = [{
            id: 'site-crumb',
            icon: 'world',
            label: craft.app.sites.getSiteById(selectedSiteId).name|t('site'),
            menu: {
                label: 'Select site'|t('app'),
                items: siteMenuItems,
            },
        }]|merge(crumbs) %}
    {% endif %}
{% endif %}
