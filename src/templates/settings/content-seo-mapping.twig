{% extends 'core-seo-geo/settings/_layout.twig' %}

{% set selectedSubnavItem = 'content-seo' %}
{% set title = mapping ? 'Edit mapping'|t('core-seo-geo') : 'Create mapping'|t('core-seo-geo') %}
{% set extraCrumbs = [
    { label: 'Content'|t('core-seo-geo'), url: url('core-seo-geo/settings/content-seo') },
    { label: section.name, url: url('core-seo-geo/settings/content-seo/' ~ section.handle) },
    { label: mapping ? 'Edit mapping'|t('core-seo-geo') : 'Create mapping'|t('core-seo-geo') },
] %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('core-seo-geo/content-seo/save-mapping') }}
    {{ hiddenInput('sectionHandle', section.handle) }}
    {{ hiddenInput('id', mapping.id ?? '') }}

    {% namespace mappingNamespace %}
        {% include 'core-seo-geo/fields/structured-data/_mappingEditor.twig' with {
            type: mapping.type ?? '',
            typeLabel: typeLabel,
            typeTree: typeTree,
            expandedTypes: expandedTypes,
            properties: mappingProperties,
            propertyGroups: propertyGroups,
            propertyTooltips: propertyTooltips,
            calculatedValueHtml: calculatedValueHtml,
            previewEntry: previewEntry,
            previewEntryCriteria: { section: section.handle },
            jsonLdPreview: jsonLdPreview,
        } only %}
    {% endnamespace %}
{% endblock %}
