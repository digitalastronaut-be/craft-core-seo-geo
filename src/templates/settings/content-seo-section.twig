{% extends 'core-seo-geo/settings/_layout.twig' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'content-seo' %}
{% set title = section.name %}
{% set extraCrumbs = [
    { label: 'Content'|t('core-seo-geo'), url: url('core-seo-geo/settings/content-seo') },
    { label: title },
] %}
{% set urlFormat = 'core-seo-geo/settings/content-seo/' ~ section.handle ~ '?site={handle}' %}
{% set selectedSiteId = site.id %}
{% set fullPageForm = true %}

{% set rowCols = {
    label: {
        heading: 'Label'|t('core-seo-geo'),
        type: 'singleline',
    },
    template: {
        heading: 'Template'|t('core-seo-geo'),
        type: 'template',
    },
    editable: {
        heading: 'Editable'|t('core-seo-geo'),
        type: 'lightswitch',
    },
} %}

{% block content %}
    {{ actionInput('core-seo-geo/content-seo/save-section') }}
    {{ redirectInput('core-seo-geo/settings/content-seo/' ~ section.handle ~ '?site=' ~ site.handle) }}
    {{ hiddenInput('sectionHandle', section.handle) }}
    {{ hiddenInput('siteId', site.id) }}

    <div class="flex-fields">
        <h2>{{ 'SEO settings'|t('core-seo-geo') }}</h2>

        {{ forms.elementSelectField({
            id: 'image',
            name: 'image',
            label: 'Default Social Image'|t('core-seo-geo'),
            instructions: "Used as the og:image/twitter:image for any entry in this section whose SEO/GEO field has no image of its own. Falls back to the global default image when left empty."|t('core-seo-geo'),
            elementType: 'craft\\elements\\Asset',
            elements: image ? [image] : [],
            criteria: { kind: 'image' },
            single: true,
            viewMode: 'thumbs',
            selectionLabel: 'Choose an image'|t('core-seo-geo'),
        }) }}

        {{ forms.editableTableField({
            label: 'Meta Title Config'|t('core-seo-geo'),
            instructions: "The blocks used to build the meta title, rendered in order and joined together. A block's template accepts {attr} shorthand and full {{ twig }} against the entry being rendered."|t('core-seo-geo'),
            id: 'titleConfig',
            name: 'titleConfig',
            addRowLabel: 'Add a block'|t('core-seo-geo'),
            allowAdd: true,
            allowReorder: true,
            allowDelete: true,
            cols: rowCols,
            rows: titleConfig,
            includeRowId: true,
        }) }}

        {{ forms.editableTableField({
            label: 'Meta Description Config'|t('core-seo-geo'),
            instructions: 'The blocks used to build the meta description. Same rules as the title blocks above.'|t('core-seo-geo'),
            id: 'descriptionConfig',
            name: 'descriptionConfig',
            addRowLabel: 'Add a block'|t('core-seo-geo'),
            allowAdd: true,
            allowReorder: true,
            allowDelete: true,
            cols: rowCols,
            rows: descriptionConfig,
            includeRowId: true,
        }) }}

        {{ forms.selectizeField({
            id: 'robots',
            name: 'robots',
            multi: true,
            label: 'Robots/AI Visibility'|t('core-seo-geo'),
            values: robots,
            options: robotsOptions,
        }) }}

        <h2>{{ 'Sitemap settings'|t('core-seo-geo') }}</h2>

        {{ forms.lightswitchField({
            label: 'Sitemap generation'|t('core-seo-geo'),
            instructions: "Include this section's entries in the sitemap: both its own sub-sitemap and its index entry."|t('core-seo-geo'),
            warning: not sitemapEnabledSitewide
                ? 'Sitemap generation is currently disabled [sitewide]({url}).'|t('core-seo-geo', {
                    url: url('core-seo-geo/settings/global-seo', {site: site.handle}) ~ '#sitemap',
                })
                : null,
            id: 'sitemapEnabled',
            name: 'sitemapEnabled',
            on: sitemapEnabled,
            onLabel: 'Enabled'|t('core-seo-geo'),
            offLabel: 'Disabled'|t('core-seo-geo'),
        }) }}

        <h2>{{ 'Markdown settings'|t('core-seo-geo') }}</h2>

        {{ forms.lightswitchField({
            label: 'Markdown page variants'|t('core-seo-geo'),
            instructions: "Serve this section's entries at their own URL plus .md, and show the Markdown sidebar pane on their edit page."|t('core-seo-geo'),
            warning: not markdownEnabledSitewide
                ? 'Markdown generation is currently disabled [sitewide]({url}).'|t('core-seo-geo', {
                    url: url('core-seo-geo/settings/global-seo', {site: site.handle}) ~ '#markdown',
                })
                : null,
            id: 'markdownEnabled',
            name: 'markdownEnabled',
            on: markdownEnabled,
            onLabel: 'Enabled'|t('core-seo-geo'),
            offLabel: 'Disabled'|t('core-seo-geo'),
        }) }}
    </div>
{% endblock %}
