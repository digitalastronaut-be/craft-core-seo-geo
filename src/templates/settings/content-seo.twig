{% extends 'core-seo-geo/settings/_layout.twig' %}

{% set selectedSubnavItem = 'content-seo' %}
{% set title = 'Content'|t('core-seo-geo') %}
{% set extraCrumbs = [
    { label: title },
] %}
{% set urlFormat = 'core-seo-geo/settings/content-seo?site={handle}' %}
{% set selectedSiteId = site.id %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% block content %}
    <div id="content-seo-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        container: '#content-seo-vue-admin-table',
        tableDataEndpoint: {{ ('core-seo-geo/content-seo/table-data?site=' ~ site.handle)|json_encode|raw }},
        search: true,
        fullPane: false,
        emptyMessage: {{ 'No sections yet.'|t('core-seo-geo')|json_encode|raw }},
        columns: [
            { name: '__slot:title', title: {{ 'Sections'|t('core-seo-geo')|json_encode|raw }}, sortField: true },
            { name: 'titleStatus', title: {{ 'Title'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'description', title: {{ 'Description'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'sitemap', title: {{ 'Sitemap'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'robots', title: {{ 'Robots'|t('core-seo-geo')|json_encode|raw }} },
            { name: 'mappings', title: {{ 'Mappings'|t('core-seo-geo')|json_encode|raw }} },
        ],
    });
{% endjs %}
