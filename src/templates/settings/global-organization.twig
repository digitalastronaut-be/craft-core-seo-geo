{% extends 'core-seo-geo/settings/_layout.twig' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'global-seo' %}
{% set title = 'Organization'|t('core-seo-geo') %}
{% set extraCrumbs = [
    { label: 'Global'|t('core-seo-geo'), url: url('core-seo-geo/settings/global-seo') },
    { label: title },
] %}
{% set urlFormat = 'core-seo-geo/settings/global/organization?site={handle}' %}
{% set selectedSiteId = site.id %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('core-seo-geo/global-structured-data/save') }}
    {{ hiddenInput('type', 'organization') }}
    {{ hiddenInput('siteId', site.id) }}
    {{ redirectInput('core-seo-geo/settings/global/organization?site=' ~ site.handle) }}

    {% namespace 'settings' %}
        <div class="flex-fields">
            {{ forms.elementSelectField({
                id: 'logo',
                name: 'logo',
                label: 'Logo'|t('core-seo-geo'),
                instructions: 'Shown as this organization\'s logo in search results and AI assistants.'|t('core-seo-geo'),
                elementType: 'craft\\elements\\Asset',
                elements: model.getLogoAsset() ? [model.getLogoAsset()] : [],
                criteria: { kind: 'image' },
                single: true,
                viewMode: 'thumbs',
                selectionLabel: 'Choose a logo'|t('core-seo-geo'),
            }) }}

            <hr>

            {{ forms.textField({
                label: 'Name'|t('core-seo-geo'),
                instructions: 'The organization\'s public-facing name.'|t('core-seo-geo'),
                id: 'name',
                name: 'name',
                value: model.name,
                required: true,
                errors: model.getErrors('name'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'Legal Name'|t('core-seo-geo'),
                instructions: 'The organization\'s full, legally registered name, if different from the name above.'|t('core-seo-geo'),
                id: 'legalName',
                name: 'legalName',
                value: model.legalName,
                errors: model.getErrors('legalName'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.autosuggestField({
                label: 'Website URL'|t('core-seo-geo'),
                id: 'url',
                name: 'url',
                value: model.url,
                suggestions: [site.getBaseUrl()],
                errors: model.getErrors('url'),
            }) }}


            <hr>

            {{ forms.textField({
                label: 'Email'|t('core-seo-geo'),
                id: 'email',
                name: 'email',
                type: 'email',
                value: model.email,
                errors: model.getErrors('email'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'Telephone'|t('core-seo-geo'),
                id: 'telephone',
                name: 'telephone',
                value: model.telephone,
                errors: model.getErrors('telephone'),
                fieldClass: 'width-50',
            }) }}
        </div>
    {% endnamespace %}

    <hr>

    <div class="flex-fields">
        {{ addressFieldHtml|raw }}

        {% namespace 'settings' %}
            {{ forms.editableTableField({
                label: 'Social Profiles'|t('core-seo-geo'),
                instructions: 'Links to this organization\'s profiles elsewhere (LinkedIn, Facebook, Instagram, Wikipedia, ...), used to help search engines and AI assistants connect them to this site.'|t('core-seo-geo'),
                id: 'sameAs',
                name: 'sameAs',
                addRowLabel: 'Add a profile'|t('core-seo-geo'),
                allowAdd: true,
                allowReorder: true,
                allowDelete: true,
                cols: {
                    url: { heading: 'URL'|t('core-seo-geo'), type: 'url' },
                },
                rows: model.sameAs,
                fieldClass: 'width-50',
            }) }}
        {% endnamespace %}
    </div>
{% endblock %}
