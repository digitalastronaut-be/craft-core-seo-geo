{% extends 'core-seo-geo/settings/_layout.twig' %}

{% import '_includes/forms.twig' as forms %}
{% import 'core-seo-geo/settings/_address.twig' as address %}
{% import 'core-seo-geo/settings/_contactPoints.twig' as contactPoints %}
{% import 'codeeditor/codeEditor' as codeEditor %}

{% set selectedSubnavItem = 'global-seo' %}
{% set title = 'Organization'|t('core-seo-geo') %}
{% set extraCrumbs = [
    { label: 'Global'|t('core-seo-geo'), url: url('core-seo-geo/settings/global-seo') },
    { label: title },
] %}
{% set urlFormat = 'core-seo-geo/settings/global/organization?site={handle}' %}
{% set selectedSiteId = site.id %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('core-seo-geo/global-structured-data/save') }}
    {{ hiddenInput('type', 'organization') }}
    {{ hiddenInput('siteId', site.id) }}
    {{ redirectInput('core-seo-geo/settings/global/organization?site=' ~ site.handle) }}

    {% namespace 'settings' %}
        <div class="flex-fields">
            {{ forms.elementSelectField({
                id: 'logo',
                name: 'logo',
                label: 'Logo'|t('core-seo-geo'),
                instructions: 'Shown as this organization\'s logo in search results and AI assistants.'|t('core-seo-geo'),
                elementType: 'craft\\elements\\Asset',
                elements: model.getLogoAsset() ? [model.getLogoAsset()] : [],
                criteria: { kind: 'image' },
                single: true,
                viewMode: 'thumbs',
                selectionLabel: 'Choose a logo'|t('core-seo-geo'),
            }) }}

            {{ forms.elementSelectField({
                id: 'image',
                name: 'image',
                label: 'Image'|t('core-seo-geo'),
                instructions: 'A general representative image (a storefront, team photo, ...), as opposed to the logo above.'|t('core-seo-geo'),
                elementType: 'craft\\elements\\Asset',
                elements: model.getImageAsset() ? [model.getImageAsset()] : [],
                criteria: { kind: 'image' },
                single: true,
                viewMode: 'thumbs',
                selectionLabel: 'Choose an image'|t('core-seo-geo'),
            }) }}

            <hr>

            {{ forms.textField({
                label: 'Name'|t('core-seo-geo'),
                instructions: 'The organization\'s public-facing name.'|t('core-seo-geo'),
                id: 'name',
                name: 'name',
                value: model.name,
                required: true,
                errors: model.getErrors('name'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'Legal Name'|t('core-seo-geo'),
                instructions: 'The organization\'s full, legally registered name, if different from the name above.'|t('core-seo-geo'),
                id: 'legalName',
                name: 'legalName',
                value: model.legalName,
                errors: model.getErrors('legalName'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'Slogan'|t('core-seo-geo'),
                id: 'slogan',
                name: 'slogan',
                value: model.slogan,
                errors: model.getErrors('slogan'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.autosuggestField({
                label: 'Website URL'|t('core-seo-geo'),
                id: 'url',
                name: 'url',
                value: model.url,
                suggestions: [site.getBaseUrl()],
                errors: model.getErrors('url'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textareaField({
                label: 'Description'|t('core-seo-geo'),
                instructions: 'A short description of the organization.'|t('core-seo-geo'),
                id: 'description',
                name: 'description',
                value: model.description,
                errors: model.getErrors('description'),
                rows: 3,
            }) }}

            <hr>

            {{ forms.textField({
                label: 'Founding Date'|t('core-seo-geo'),
                instructions: 'e.g. `2008-01-01`, or just a year.'|t('core-seo-geo'),
                id: 'foundingDate',
                name: 'foundingDate',
                value: model.foundingDate,
                errors: model.getErrors('foundingDate'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'VAT ID'|t('core-seo-geo'),
                instructions: 'The VAT registration number.'|t('core-seo-geo'),
                id: 'vatID',
                name: 'vatID',
                value: model.vatID,
                errors: model.getErrors('vatID'),
                fieldClass: 'width-50',
            }) }}

            {{ forms.textField({
                label: 'Tax ID'|t('core-seo-geo'),
                instructions: 'A national tax identification number.'|t('core-seo-geo'),
                id: 'taxID',
                name: 'taxID',
                value: model.taxID,
                errors: model.getErrors('taxID'),
                fieldClass: 'width-50',
            }) }}
        </div>
    {% endnamespace %}

    <hr>

    {% namespace 'settings' %}
        <div class="flex-fields">
            {{ contactPoints.fields(model) }}
        </div>
    {% endnamespace %}

    <hr>

    {% namespace 'settings' %}
        {{ address.fields(model) }}
    {% endnamespace %}

    <hr>

    {% namespace 'settings' %}
        <div class="flex-fields">
            {{ forms.editableTableField({
                label: 'Social Profiles'|t('core-seo-geo'),
                instructions: 'Links to this organization\'s profiles elsewhere (LinkedIn, Facebook, Instagram, Wikipedia, ...), used to help search engines and AI assistants connect them to this site.'|t('core-seo-geo'),
                id: 'sameAs',
                name: 'sameAs',
                addRowLabel: 'Add a profile'|t('core-seo-geo'),
                allowAdd: true,
                allowReorder: true,
                allowDelete: true,
                cols: {
                    url: { heading: 'URL'|t('core-seo-geo'), type: 'url' },
                },
                rows: model.sameAs,
                fieldClass: 'width-50',
            }) }}
        </div>
    {% endnamespace %}

    <hr>

    {% namespace 'settings' %}
        {{ codeEditor.textareaField({
            label: 'Additional Properties'|t('core-seo-geo'),
            instructions: 'A JSON object of extra schema.org `Organization` properties - merged into the generated object last, overriding any matching key. An escape hatch for anything the fields above don\'t cover.'|t('core-seo-geo'),
            id: 'additionalProperties',
            name: 'additionalProperties',
            value: model.additionalProperties,
            errors: model.getErrors('additionalProperties'),
            class: ['code'],
            rows: 6,
        }, 'CodeEditor', {
            theme: 'vs',
            language: 'json',
            lineNumbers: 'on',
            lineNumbersMinChars: 3,
            lineDecorationsWidth: 16,
        }, {
            wrapperClass: 'monaco-editor-background-frame',
        }) }}
    {% endnamespace %}
{% endblock %}

{% block details %}
    <div class="meta">
        {{ forms.lightswitchField({
            label: 'Enabled'|t('core-seo-geo'),
            id: 'enabled',
            name: 'enabled',
            on: enabled,
        }) }}
    </div>
{% endblock %}
