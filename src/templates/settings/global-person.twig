{% extends 'core-seo-geo/settings/_layout.twig' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'global-seo' %}
{% set title = 'Person'|t('core-seo-geo') %}
{% set extraCrumbs = [
    { label: 'Global'|t('core-seo-geo'), url: url('core-seo-geo/settings/global-seo') },
    { label: 'Person'|t('core-seo-geo'), url: url('core-seo-geo/settings/global/person') },
] %}
{% set urlFormat = 'core-seo-geo/settings/global/person?site={handle}' %}
{% set selectedSiteId = site.id %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('core-seo-geo/global-structured-data/save') }}
    {{ hiddenInput('type', 'person') }}
    {{ hiddenInput('siteId', site.id) }}
    {{ redirectInput('core-seo-geo/settings/global/person?site=' ~ site.handle) }}

    <p class="light">{{ "Describes a person behind this site - a personal site's owner, or a company blog's author - shown to search engines and AI assistants on every page. Leave every field empty to stop sending this object."|t('core-seo-geo') }}</p>

    {% namespace 'settings' %}
        <div class="flex-fields">
            {{ forms.textField({
                label: 'Name'|t('core-seo-geo'),
                id: 'name',
                name: 'name',
                value: model.name,
                required: true,
                errors: model.getErrors('name'),
            }) }}

            {{ forms.textField({
                label: 'Job Title'|t('core-seo-geo'),
                id: 'jobTitle',
                name: 'jobTitle',
                value: model.jobTitle,
                errors: model.getErrors('jobTitle'),
            }) }}

            {{ forms.textField({
                label: 'Works For'|t('core-seo-geo'),
                instructions: 'The organization this person is associated with, if any.'|t('core-seo-geo'),
                id: 'worksFor',
                name: 'worksFor',
                value: model.worksFor,
                errors: model.getErrors('worksFor'),
            }) }}

            {{ forms.autosuggestField({
                label: 'URL'|t('core-seo-geo'),
                instructions: "This person's own site, or a profile page about them on this one."|t('core-seo-geo'),
                id: 'url',
                name: 'url',
                value: model.url,
                suggestions: [site.getBaseUrl()],
                errors: model.getErrors('url'),
            }) }}

            {{ forms.elementSelectField({
                id: 'image',
                name: 'image',
                label: 'Photo'|t('core-seo-geo'),
                elementType: 'craft\\elements\\Asset',
                elements: model.getImageAsset() ? [model.getImageAsset()] : [],
                criteria: { kind: 'image' },
                single: true,
                viewMode: 'thumbs',
                selectionLabel: 'Choose a photo'|t('core-seo-geo'),
            }) }}

            <hr>

            {{ forms.textField({
                label: 'Email'|t('core-seo-geo'),
                id: 'email',
                name: 'email',
                type: 'email',
                value: model.email,
                errors: model.getErrors('email'),
            }) }}

            {{ forms.textField({
                label: 'Telephone'|t('core-seo-geo'),
                id: 'telephone',
                name: 'telephone',
                value: model.telephone,
                errors: model.getErrors('telephone'),
            }) }}

            <hr>

            {{ forms.editableTableField({
                label: 'Social Profiles'|t('core-seo-geo'),
                instructions: "Links to this person's profiles elsewhere (LinkedIn, X, Instagram, ...)."|t('core-seo-geo'),
                id: 'sameAs',
                name: 'sameAs',
                addRowLabel: 'Add a profile'|t('core-seo-geo'),
                allowAdd: true,
                allowReorder: true,
                allowDelete: true,
                cols: {
                    url: { heading: 'URL'|t('core-seo-geo'), type: 'url' },
                },
                rows: model.sameAs,
            }) }}
        </div>
    {% endnamespace %}
{% endblock %}
